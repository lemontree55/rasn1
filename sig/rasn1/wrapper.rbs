module RASN1
  # This class is used to wrap a {Types::Base} or {Model} instance to force its options.
  #
  # == Usage
  # This class may be used to wrap another Rasn2 object by 4 ways:
  # * wrap an object to modify its options,
  # * implicitly wrap an object (i.e. change its tag),
  # * explicitly wrap an object (i.e wrap the object in another explicit ASN.1 tag),
  # * wrap a choice model to reuse it in its own definition.
  #
  # @example Wrapping object
  #   # object to wrap
  #   int = Rasn2::Types::Integer.new(implicit: 1)    # its tag is 0x81
  #   # simple wrapper, change an option
  #   wrapper = Rasn2::Wrapper.new(int, default: 1)
  #   # implicit wrapper
  #   wrapper = Rasn2::Wrapper.new(int, implicit: 3)  # wrapped int tag is now 0x83
  #   # explicit wrapper
  #   wrapper = Rasn2::Wrapper.new(int, explicit: 4)  # int tag is always 0x81, but it is wrapped in a 0x84 tag
  # @example Wrapping a choice to make it recursive
  #  class RecursiveChoice < Rasn2::Model
  #    choice :choice,
  #           content: [
  #             integer(:value, implicit: 1),
  #             wrapper(model(:recursive, RecursiveChoice), implicit:2)
  #           ]
  #  end
  # @since 0.12.0
  # @since 0.15.0 Wrappers are lazy. They allocate their inner element only when needed (i.e. when calling {#to_der}, {#parse!} or {#element})
  # @author Sylvain Daubert
  # @author LemonTree55
  class Wrapper < SimpleDelegator
    @lazy: untyped

    @element_options_to_merge: untyped

    @options: untyped

    @explicit: int?

    @implicit: int?

    # ExplicitWrapper is a hand-made explicit tag, but we have to use its implicit option
    # to force its tag value.
    @explicit_wrapper: untyped

    # @private Private class used to build/parse explicit wrappers
    class ExplicitWrapper < Types::Base
      ID: 0

      ASN1_PC: 0

      def self.type: () -> ""

      # @return [Boolean]
      # @see Types::Base#can_build?
      def can_build?: () -> bool

      private

      def value_to_der: () -> string

      def inspect_value: () -> ""
    end

    # @param [Types::Base,Model] element element to wrap
    # @param [Hash] options
    def initialize: (Types::Base|Model element, ?::Hash[untyped, untyped] options) -> void

    # Say if wrapper is an explicit one (i.e. add tag and length to its element)
    # @return [Boolean]
    def explicit?: () -> bool

    # Say if wrapper is an implicit one (i.e. change tag of its element)
    # @return [Boolean]
    def implicit?: () -> bool

    # Convert wrapper and its element to a DER string
    # @return [String]
    # @since 0.12.0
    # @since 0.15.0 Allocate element (lazy wrapper)
    def to_der: () -> string

    # Parse a DER string. This method updates object.
    # @param [String] der DER string
    # @param [Boolean] ber if +true+, accept BER encoding
    # @return [Integer] total number of parsed bytes
    # @raise [ASN1Error] error on parsing
    # @since 0.12.0
    # @since 0.15.0 Allocate element (lazy wrapper)
    def parse!: (string der, ?ber: bool) -> int

    # @private
    # @see Types::Base#do_parse
    def do_parse: (string der, ?ber: bool) -> untyped

    # @return [Boolean]
    # @see Types::Base#value?
    def value?: () -> bool?

    # Return Wrapped element
    # @return [Types::Base,Model]
    # @since 0.12.0
    # @since 0.15.0 Allocate element (lazy wrapper)
    def element: -> (Types::Base | Model)

    # @return [::Integer]
    # @see Types::Base#id
    def id: () -> int

    # @return [Symbol]
    # @see Types::Base#asn1_class
    def asn1_class: () -> intern

    # @return [Boolean]
    # @see Types::Base#constructed
    def constructed?: () -> bool

    # @return [Boolean]
    # @see Types::Base#primitive
    def primitive?: () -> bool

    # @param [::Integer] level
    # @return [String]
    def inspect: (int? level) -> string

    private

    def explicit_implicit: (untyped options) -> untyped

    def generate_explicit_wrapper: (untyped options) -> untyped

    def generate_explicit_wrapper_options: (untyped options) -> untyped

    def generate_implicit_element: (?untyped? from) -> untyped

    def lazy_generation: (?register: bool) -> untyped
  end
end
